# Maintainer: achraf <achraf@pacseek.local>
# Template lives in the pakmap repo (packaging/aur/pakmap/PKGBUILD) and is
# published to the AUR as `pakmap` at each release. Completions and the man
# page are generated by the binary itself (--generate-completions /
# --generate-man) so they can never drift from the clap parser.
pkgname=pakmap
pkgver=0.10.3
pkgrel=1
pkgdesc="Fast AUR + official repo + Flatpak search with TUI install/remove/upgrade for Arch/Artix"
arch=('x86_64')
url="https://github.com/kenjaku-dev/pakmap"
license=('MIT')
depends=('pacman>=5.1' 'pacman-contrib' 'git' 'base-devel')
makedepends=('cargo')
optdepends=('flatpak: Flatpak source search, updates and install/remove')
provides=('pakmap')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/kenjaku-dev/pakmap/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # replaced with the real sum at publish time

build() {
  cd "pakmap-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo build --release --locked
  # the binary prints its own integration artifacts (single clap source):
  ./target/release/pakmap --generate-completions bash > pakmap.bash
  ./target/release/pakmap --generate-completions zsh  > _pakmap
  ./target/release/pakmap --generate-completions fish > pakmap.fish
  ./target/release/pakmap --generate-man > pakmap.1
}

check() {
  cd "pakmap-${pkgver}"
  ./target/release/pakmap --version
}

package() {
  cd "pakmap-${pkgver}"
  _prefix="${pkgdir}/usr"
  install -Dm755 "${srcdir}/target/release/pakmap" "${_prefix}/bin/pakmap"
  install -Dm644 pakmap.bash "${_prefix}/share/bash-completion/completions/pakmap"
  install -Dm644 _pakmap     "${_prefix}/share/zsh/site-functions/_pakmap"
  install -Dm644 pakmap.fish "${_prefix}/share/fish/vendor_completions.d/pakmap.fish"
  install -Dm644 pakmap.1    "${_prefix}/share/man/man1/pakmap.1"
  install -Dm644 LICENSE "${_prefix}/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${_prefix}/share/doc/${pkgname}/README.md"
}
